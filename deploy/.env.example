# Copy to `.env` (same folder) and adjust before running `docker compose up`.
# docker compose automatically loads `.env` from the compose file's directory.

# MySQL root password (also used by the app to connect).
DB_PASSWORD=powergrid-root

# HTTP Basic credentials for the protected legacy /msg/** push API.
OPS_USERNAME=operator
OPS_PASSWORD=powergrid-demo

# Real-carrier SMS via Tencent Cloud (https://console.cloud.tencent.com/smsv2).
# Leave SMS_TENCENT_ENABLED=false (or unset) to keep the SMS channel as a log-only stub.
# SecretId/SecretKey: 访问管理(CAM) > API 密钥管理 (https://console.cloud.tencent.com/cam/capi)
# SdkAppId/SignName/TemplateId: 短信控制台 > 应用管理 / 签名管理 / 正文模板管理
#SMS_TENCENT_ENABLED=true
#SMS_TENCENT_REGION=ap-guangzhou
#SMS_TENCENT_SECRET_ID=<your-tencent-secret-id>
#SMS_TENCENT_SECRET_KEY=<your-tencent-secret-key>
#SMS_TENCENT_SDK_APP_ID=1400xxxxxx
#SMS_TENCENT_SIGN_NAME=你的签名
#SMS_TENCENT_TEMPLATE_ID=2000xxxxx

# Lark/Feishu group "custom bot" webhook — no enterprise verification or template review needed.
# In the Feishu desktop/web app: open (or create) a group -> group settings -> 群机器人 -> 添加机器人
# -> 自定义机器人 -> give it a name -> copy the generated webhook URL below.
# Leave LARK_WEBHOOK_ENABLED=false (or unset) to keep the Lark channel as a log-only stub.
#LARK_WEBHOOK_ENABLED=true
#LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: only set if you turned on "签名校验" (signature verification) for the bot.
#LARK_WEBHOOK_SECRET=

# 163 SMTP. Use the client authorization code, not the mailbox login password.
#EMAIL_ENABLED=true
#EMAIL_HOST=smtp.163.com
#EMAIL_PORT=465
#EMAIL_ACCOUNT=you@163.com
#EMAIL_AUTH_CODE=
