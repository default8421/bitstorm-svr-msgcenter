# Settings for a public host. Copy to `.env` on the server (NOT in git) and
# start with:  docker compose -f docker-compose.yml -f docker-compose.server.yml up -d

DB_PASSWORD=powergrid-root

# Queue backend: false = Kafka topics, true = MySQL-as-queue.
MYSQL_AS_MQ=false

# Mount under a path prefix when another service already owns "/".
# Must match the reverse-proxy location block.
CONTEXT_PATH=/msgcenter

# Bind the app to the docker-bridge gateway rather than 0.0.0.0 so only the
# on-box reverse proxy can reach it. Adjust to match `docker network inspect`.
APP_PUBLISH=172.18.0.1:8082
# Datastores stay on loopback — for on-box debugging only.
MYSQL_PUBLISH=127.0.0.1:3307
REDIS_PUBLISH=127.0.0.1:6380

# HTTP Basic credentials for the protected /msg/** and /api/powergrid/simulate|reset endpoints.
# "powergrid-demo" is a public placeholder (it's committed to git and prefilled nowhere in the
# UI, but still guessable) -- this host is reachable from the internet, so generate a real
# secret before going live:  OPS_PASSWORD=$(openssl rand -base64 24)
OPS_USERNAME=operator
OPS_PASSWORD=powergrid-demo

# Lark/Feishu group "custom bot" webhook.
LARK_WEBHOOK_ENABLED=true
LARK_WEBHOOK_URL=

# 消费侧流量治理。渠道硬限额以数据库 t_global_quota 为准；这里是 YAML 兜底，并控制入口积压水位。
# 2026-08-26 直打应用实测：Kafka 受理约 1300 QPS；短信渠道 200 条/秒合同下真实发送约 160/s。
MSGCENTER_PLATFORM_QPS=500
MSGCENTER_PLATFORM_BURST=1000
MSGCENTER_ADMISSION_SOFT=4000
MSGCENTER_ADMISSION_HARD=12000
# 入库路径连接池：直打应用约 3000 受理 QPS 时，默认 Hikari=10 / Jedis=8 会先把入口堵住。
DB_POOL_MAX=40
REDIS_POOL_MAX_ACTIVE=32
REDIS_POOL_MAX_IDLE=16
