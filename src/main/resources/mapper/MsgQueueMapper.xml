<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.bitoffer.msgcenter.core.mapper.MsgQueueMapper">
    <resultMap id="msgMap" type="cn.bitoffer.msgcenter.core.model.MsgQueueModel">
        <result column="id" property="id" />
        <result column="msg_id" property="msgId"/>
        <result column="to"  property="to"/>
        <result column="subject"  property="subject"/>
        <result column="priority"  property="priority"/>
        <result column="channel"  property="channel"/>
        <result column="template_id"  property="templateId"/>
        <result column="template_data"  property="templateData"/>
        <result column="status"  property="status"/>
    </resultMap>

    <insert id="save" useGeneratedKeys="true" keyProperty="msgQueueModel.id">
        insert into ${tableName} (`msg_id`,`to`,`subject`,`priority`,`channel`,`template_id`,`template_data`,`status`)
        values (#{msgQueueModel.msgId},#{msgQueueModel.to},#{msgQueueModel.subject},#{msgQueueModel.priority},#{msgQueueModel.channel},#{msgQueueModel.templateId},#{msgQueueModel.templateData},#{msgQueueModel.status});
    </insert>

    <select id="getMsgById" resultType="cn.bitoffer.msgcenter.core.model.MsgQueueModel" resultMap="msgMap">
        select * from ${tableName} where msg_id = #{msgId}
    </select>

    <select id="getMsgsByStatus" resultMap="msgMap">
        select * from ${tableName} where status = #{status} LIMIT #{limit}
    </select>

    <update id="setStatus">
        update ${tableName} set status = #{status} where msg_id = #{msgId}
    </update>

    <update id="batchSetStatus">
        update ${tableName} set status = #{status} where msg_id in ${msgIdList}
    </update>

    <select id="selectPendingForUpdate" resultMap="msgMap">
        select * from ${tableName}
        where status = #{status}
          and (next_attempt_at is null or next_attempt_at <![CDATA[<=]]> now())
        order by id
        limit #{limit}
        for update skip locked
    </select>

    <update id="claimByMsgIds">
        update ${tableName}
        set status = #{toStatus}
        where msg_id in ${msgIdList} and status = #{fromStatus}
    </update>

    <update id="recoverStaleProcessing">
        update ${tableName}
        set status = #{toStatus}
        where status = #{fromStatus}
          and modify_time <![CDATA[<]]> date_sub(now(), interval #{staleSeconds} second)
    </update>

    <!-- 子查询里的 limit 把扫描量封顶：过载时这个查询本身不能变成新的压力源。 -->
    <select id="countPendingCapped" resultType="long">
        select count(*) from (
            select 1 from ${tableName}
            where status = #{status}
              and (next_attempt_at is null or next_attempt_at <![CDATA[<=]]> now())
            limit #{cap}
        ) capped
    </select>

    <!-- 按主键序取第一行，走 idx_status_id，不需要对 create_time 排序。 -->
    <select id="oldestPendingCreateTime" resultType="java.util.Date">
        select create_time from ${tableName}
        where status = #{status}
        order by id
        limit 1
    </select>

    <update id="setRetryScheduled">
        update ${tableName}
        set status = #{status},
            next_attempt_at = date_add(now(), interval #{delaySeconds} second)
        where msg_id = #{msgId}
    </update>
</mapper>
